<?xml version="1.0" encoding="utf-8"?>
<!--
  Lyrian 的啟動圖示。

  用向量（VectorDrawable）而非 PNG：任何解析度都清晰，且不必維護多套尺寸。
  這是暫時的圖示，之後會替換為正式設計。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景：單色系 primary -->
    <path
        android:fillColor="#4B4BD5"
        android:pathData="M0,0h108v108h-108z" />

    <!-- 歌詞行（三條水平線，象徵歌詞） -->
    <path
        android:fillColor="#E1E1F8"
        android:pathData="M26,38h42v7h-42z" />
    <path
        android:fillColor="#E1E1F8"
        android:pathData="M26,52h56v7h-56z" />
    <!-- 第三行挖空（表現本 App 的核心行為） -->
    <path
        android:fillColor="#E1E1F8"
        android:pathData="M26,66h18v7h-18z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,66h32v7h-32z" />
</vector>
