<?xml version="1.0" encoding="utf-8"?>
<!--
  Lyrian 的啟動底色。

  這裡刻意只放「啟動視窗」用的靜態色，避免冷啟動時白閃。
  實際 UI 顏色全部由 Compose 的 MaterialTheme 提供（含動態配色）。
  值對應單色系色票的 surface（見 docs/mockups/mono-scheme.kt）。
-->
<resources>
    <color name="lyrian_launch_background">#FAFAFA</color>

    <!--
      自適應圖示的底色層（Android 8.0+）。
      與 mipmap/ic_launcher.xml 的 #4B4BD5 是同一個單色系 primary。
    -->
    <color name="ic_launcher_background">#4B4BD5</color>
</resources>
