<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8.0 **以下**的傳統啟動圖示。

  自適應圖示（`mipmap-anydpi-v26/`）是兩層疊起來的，但 API 26 以前
  的 launcher 只認一個 drawable，所以這裡把「底色 + 歌詞線條」
  合成在同一張圖上。

  ⚠️ **必須放在 `mipmap-*` 而不是 `drawable-*`**：`ic_launcher` 是 mipmap
  資源，launcher 會用 `@mipmap/` 參照它。放在 drawable 再用 `<item type="mipmap">`
  別名指向 drawable，會被 Lint 判為 `Unexpected resource reference type`
  （release build 的 `lintVitalRelease` 會直接讓建置失敗）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底色：單色系 primary -->
    <path
        android:fillColor="#4B4BD5"
        android:pathData="M0,0h108v108h-108z" />

    <!-- 歌詞行 -->
    <path
        android:fillColor="#E1E1F8"
        android:pathData="M26,38h42v7h-42z" />
    <path
        android:fillColor="#E1E1F8"
        android:pathData="M26,52h56v7h-56z" />
    <!-- 第三行挖空 -->
    <path
        android:fillColor="#E1E1F8"
        android:pathData="M26,66h18v7h-18z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,66h32v7h-32z" />
</vector>
